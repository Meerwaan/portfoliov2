      "note": {
        "fr": "disponibilité et noms réservés",
        "en": "availability and reserved names"
      }
    },
    {
      "id": "editor",
      "method": "GET",
      "path": "/editor/[[...id]]",
      "note": {
        "fr": "éditeur de la sphère et des médias",
        "en": "sphere and media editor"
      }
    },
    {
      "id": "portfolios-id",
      "method": "PATCH",
      "path": "/api/portfolios/[id]",
      "note": {
        "fr": "sauvegarde, validée par Zod",
        "en": "save, validated with Zod"
      }
    },
    {
      "id": "track",
      "method": "POST",
      "path": "/api/track",
      "note": {
        "fr": "statistiques de visite par jour",
        "en": "daily visit statistics"
      }
    },
    {
      "id": "export",
      "method": "GET",
      "path": "/api/account/export",
      "note": {
        "fr": "export des données du compte",
        "en": "account data export"
      }
    }
