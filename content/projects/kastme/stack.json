  "routes": [
    {
      "id": "public-slug",
      "method": "GET",
      "path": "/[slug]",
      "note": {
        "fr": "page publique, SSR + ISR, image OG générée",
        "en": "public page, SSR + ISR, generated OG image"
      }
    },
    {
      "id": "legacy-p",
      "method": "GET",
      "path": "/p/[id]",
      "note": {
        "fr": "ancienne URL, redirection 301 vers le slug",
        "en": "old URL, 301 to the slug"
      }
    },
    {
      "id": "register",
      "method": "GET",
      "path": "/register",
      "note": {
        "fr": "inscription Firebase Auth",
        "en": "Firebase Auth sign-up"
      }
    },
    {
      "id": "slug-check",
      "method": "GET",
